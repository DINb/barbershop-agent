# Copie este arquivo para ".env" e preencha com seus valores reais.
# NUNCA suba o arquivo ".env" (com valores reais) para o GitHub.

GROQ_API_KEY=sua_chave_groq_aqui

# Numero (com codigo do pais, sem espacos/simbolos) do dono do negocio,
# usado para notificar quando o agente transferir uma conversa para humano.
OWNER_PHONE=numero_do_dono_do_negocio

# --- Meta Cloud API (opcional, se for usar no futuro) ---
WHATSAPP_TOKEN=token_gerado_no_meta_app_dashboard
WHATSAPP_PHONE_ID=id_do_numero_de_teste
VERIFY_TOKEN=escolha_uma_palavra_secreta_qualquer

# --- Z-API (usado agora, para destravar a demo) ---
ZAPI_INSTANCE_ID=id_da_instancia_zapi
ZAPI_TOKEN=token_da_instancia_zapi
ZAPI_CLIENT_TOKEN=client_token_da_conta_zapi
